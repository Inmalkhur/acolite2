/**
 * Bothost may run: node python3 main.py
 * (node + script "python3" + arg "main.py")
 */
const { spawn } = require("child_process");
const py = process.env.PYTHON || "python3";
const target = process.argv[2] || "main.py";
const child = spawn(py, [target], { stdio: "inherit", cwd: __dirname });
child.on("error", (err) => {
  console.error(err);
  process.exit(1);
});
child.on("exit", (code, signal) => {
  process.exit(signal ? 1 : code ?? 0);
});
